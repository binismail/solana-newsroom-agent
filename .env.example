# Synapse RPC URL (OOBE Protocol) — Get your free API key at https://oobeprotocol.ai
SOLANA_RPC_URL=https://staging.oobeprotocol.ai:8080/rpc?api_key=sk_live_YOUR_API_KEY

# Solana Network (devnet or mainnet-beta)
SOLANA_NETWORK=mainnet-beta

# Private key as a JSON array [1,2,3...] or base58 string (takes precedence over SOLANA_KEYPAIR_PATH)
SOLANA_PRIVATE_KEY=

# Optional: Path to keypair file if private key is not provided directly
SOLANA_KEYPAIR_PATH=./agent-keypair.json

# Target news website or blog URL to scrape
SCRAPE_TARGET_URL=https://solana.com/news

# Interval in milliseconds between pipeline iterations (default: 5 minutes)
LOOP_INTERVAL_MS=300000

# =========================================================================
# Optional: Ace Data Cloud API Token
# Set this token if you wish to bypass the X402 payment verification flow
# and test the full Trigger -> Scrape -> LLM -> Flux Image pipeline on Devnet.
# =========================================================================
ACEDATACLOUD_API_TOKEN=
